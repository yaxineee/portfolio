# YAXIS frontend — Vercel environment variables
#
# Copy this file to .env (local) or set these in the Vercel project dashboard
# (Project Settings → Environment Variables).

# The origin of the PHP backend (Namecheap shared hosting).
# Used by build.sh to rewrite /api/setlang.php?next=... to the Vercel origin.
BACKEND_URL=https://yaxis.lodev.store

# The origin of this Vercel deployment. The language switcher's
# `next=` parameter points back to this URL after the cookie is set.
FRONTEND_URL=https://yaxxis.vercel.app
